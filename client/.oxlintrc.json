{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc", "typescript", "nextjs"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "metadata",
          "viewport",
          "generateMetadata",
          "generateViewport",
          "generateStaticParams",
          "dynamic",
          "dynamicParams",
          "revalidate",
          "fetchCache",
          "runtime",
          "preferredRegion",
          "maxDuration"
        ]
      }
    ]
  }
}
